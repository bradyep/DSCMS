@{
  ViewData["Title"] = "Edit Content";
  var contentId = ViewData["ContentId"];
}

<div id="contentIdHolder" data-contentid="@contentId" style="display:none;"></div>

<h2>Edit</h2>

<form id="editForm" class="form-horizontal">
  <h4>Content</h4>
  <hr />
  <div class="form-group">
    <label for="BodySource" class="col-md-2 control-label">Body Source</label>
    <div class="col-md-10">
      <textarea id="BodySource" class="form-control" rows="20"></textarea>
    </div>
  </div>
  <div class="form-group">
    <label for="BodySourceTypeId" class="control-label col-md-2">Body Source Type</label>
    <div class="col-md-10">
      <select id="BodySourceTypeId" class="form-control"></select>
    </div>
  </div>
  <div class="form-group">
    <label for="ContentTypeId" class="control-label col-md-2">Content Type</label>
    <div class="col-md-10">
      <select id="ContentTypeId" class="form-control"></select>
    </div>
  </div>
  <div class="form-group">
    <label for="TemplateId"
    <div class="col-md-10">
      <select id="TemplateId" class="form-control"></select>
    </div>
  </div>
  <div class="form-group">
    <label for="Title" class="col-md-2 control-label">Title</label>
    <div class="col-md-10">
      <input id="Title" type="text" class="form-control" />
    </div>
  </div>
  <div class="form-group">
    <label for="UrlToDisplay" class="col-md-2 control-label">URL To Display</label>
    <div class="col-md-10">
      <input id="UrlToDisplay" type="text" class="form-control" />
    </div>
  </div>

  <h4>Content Type Field Items</h4>

  <p>
    <a asp-route="ContentTypeFieldItems" asp-route-action="Create" asp-route-id="@contentId">Create New Field Item</a>
  </p>
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Value</th>
        <th></th>
      </tr>
    </thead>
    <tbody id="fieldItemsTableBody">
      <tr>
        <td colspan="3">Loading...</td>
      </tr>
    </tbody>
  </table>

  <div class="form-group">
    <div class="col-md-offset-2 col-md-10">
      <button type="submit" class="btn btn-default">Save</button>
    </div>
  </div>
</form>

<div>
  <a asp-controller="ContentsView" asp-action="Index">Back to List</a>
</div>

<script src="~/js/contents/edit.js"></script>
