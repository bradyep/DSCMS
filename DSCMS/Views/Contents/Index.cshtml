@{
  ViewData["Title"] = "Contents";
}

<h2>Contents</h2>

<p>
  <a asp-controller="ContentsView" asp-action="Create">Create New</a>
</p>

<form id="filterForm" method="get">
  <p>
    <select id="contentTypeFilter" name="contentType" class="form-control filter"></select>
    <button type="submit" class="btn btn-default">Filter</button>
  </p>
</form>

<table class="table">
  <thead>
    <tr>
      <th>Title</th>
      <th>Content Type</th>
      <th>URL To Display</th>
      <th>Body Source</th>
      <th>Last Updated Date</th>
      <th></th>
    </tr>
  </thead>
  <tbody id="contentsTableBody">
    <tr>
      <td colspan="6" class="text-center">Loading...</td>
    </tr>
  </tbody>
</table>

<script src="~/js/contents/index.js"></script>
