@{
  ViewData["Title"] = "Delete";
  var contentId = ViewData["ContentId"];
}

<div id="contentIdHolder" data-contentid="@contentId" style="display:none;"></div>

<h2>Delete</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
  <h4>Content</h4>
  <hr />
  <dl class="dl-horizontal">
    <dt>Body Source</dt>
    <dd id="bodySource">Loading...</dd>
    <dt>Creation Date</dt>
    <dd id="creationDate">Loading...</dd>
    <dt>Last Updated Date</dt>
    <dd id="lastUpdatedDate">Loading...</dd>
    <dt>Title</dt>
    <dd id="title">Loading...</dd>
    <dt>URL To Display</dt>
    <dd id="urlToDisplay">Loading...</dd>
  </dl>

  <form id="deleteForm">
    <div class="form-actions no-color">
      <button type="submit" class="btn btn-default">Delete</button> |
      <a asp-controller="ContentsView" asp-action="Index">Back to List</a>
    </div>
  </form>
</div>

<script src="~/js/contents/delete.js"></script>
