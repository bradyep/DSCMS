@{
  ViewData["Title"] = "Create Content";
}

<h2>Create</h2>

<form id="createForm" class="form-horizontal">
  <h4>Content</h4>
  <hr />
  <div class="form-group">
    <label for="BodySource" class="col-md-2 control-label">Body Source</label>
    <div class="col-md-10">
      <textarea id="BodySource" class="form-control" rows="20"></textarea>
    </div>
  </div>
  <div class="form-group">
    <label for="ContentTypeId" class="col-md-2 control-label">Content Type</label>
    <div class="col-md-10">
      <select id="ContentTypeId" class="form-control"></select>
    </div>
  </div>
  <div class="form-group" hidden>
    <label for="CreatedBy" class="col-md-2 control-label">Created By</label>
    <div class="col-md-10">
      <select id="CreatedBy" class="form-control"></select>
    </div>
  </div>
  <div class="form-group" hidden>
    <label for="LastUpdatedBy" class="col-md-2 control-label">Last Updated By</label>
    <div class="col-md-10">
      <select id="LastUpdatedBy" class="form-control"></select>
    </div>
  </div>
  <div class="form-group">
    <label for="TemplateId" class="col-md-2 control-label">Template</label>
    <div class="col-md-10">
      <select id="TemplateId" class="form-control"></select>
    </div>
  </div>
  <div class="form-group">
    <label for="Title" class="col-md-2 control-label">Title</label>
    <div class="col-md-10">
      <input id="Title" type="text" class="form-control" />
    </div>
  </div>
  <div class="form-group">
    <label for="UrlToDisplay" class="col-md-2 control-label">URL To Display</label>
    <div class="col-md-10">
      <input id="UrlToDisplay" type="text" class="form-control" />
    </div>
  </div>
  <div class="form-group">
    <label for="BodySourceTypeId" class="col-md-2 control-label">Body Source Type</label>
    <div class="col-md-10">
      <select id="BodySourceTypeId" class="form-control"></select>
    </div>
  </div>
  <div class="form-group">
    <div class="col-md-offset-2 col-md-10">
      <button type="submit" class="btn btn-default">Create</button>
    </div>
  </div>
</form>

<div>
  <a asp-controller="ContentsView" asp-action="Index">Back to List</a>
</div>

<script src="~/js/contents/create.js"></script>
