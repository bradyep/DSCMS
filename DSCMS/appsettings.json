{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=dscms-data/dscms.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "DSCMS": "Debug"
    }
  },
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "Username": "",
    "Password": "",
    "EnableSsl": true,
    "FromEmail": "noreply@dscms.local",
    "FromName": "DSCMS System"
  },
  "DatabaseSettings": {
    "DatabaseType": "SQLite",
    "CommandTimeout": 30
  },
  "StaticFileSettings": {
    "StoragePath": "dscms-data/static",
    "MaxUploadBytes": 209715200,
    "MaxExtractedBytes": 1073741824,
    "MaxArchiveEntries": 5000
  },
  "BackupSettings": {
    "StoragePath": "dscms-data/backups",
    "MaxRestoreBytes": 2147483648,
    "MaxExtractedBytes": 10737418240,
    "MaxArchiveEntries": 50000,
    "SnapshotsToKeep": 3
  },
  "AllowedHosts": "*"
}
